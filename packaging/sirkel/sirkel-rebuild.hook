# KWin only loads effects built for its exact version, so Sirkel stops
# working after every KWin upgrade until it's rebuilt. A pacman hook can't
# rebuild it (makepkg doesn't run as root), so it says so at the right time.
[Trigger]
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = Reminding to rebuild Sirkel for the new KWin...
When = PostTransaction
Exec = /bin/sh -c 'echo "==> Sirkel: KWin was upgraded. Rebuild Sirkel (makepkg -si in its PKGBUILD folder, or your AUR helper), then log out and back in."'
