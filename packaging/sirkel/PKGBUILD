# Stable release build. For the latest commit, use packaging/sirkel-git/PKGBUILD.
# On a new release, update pkgver and the checksum
# (updpkgsums).
pkgname=sirkel
pkgver=0.5.3
pkgrel=1
pkgdesc="Loop-inspired directional window snapping for KDE Plasma (KWin effect)"
arch=('x86_64' 'aarch64')
url="https://github.com/strandzen/Sirkel"
license=('GPL-2.0-or-later')
depends=('kwin' 'qt6-base' 'qt6-declarative' 'kconfig' 'kcolorscheme' 'kcoreaddons'
         'kglobalaccel' 'ki18n' 'kcmutils' 'kwindowsystem' 'kirigami' 'kdeclarative')
makedepends=('cmake' 'extra-cmake-modules' 'vulkan-headers')
optdepends=('keyd: use Caps Lock as the trigger (otherwise pick a key combination in the settings)')
conflicts=('sirkel-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "sirkel-rebuild.hook")
sha256sums=('eb6fb35d52d8f7473228288692febbbe8350998b2bb2670ea7ed8ff5ae89cf96'
            '0ec0d6d01cfec80cf2da03f7984b01ca997e55c9016b01a7198e319db1332eb8')

build() {
  cmake -B build -S "Sirkel-$pkgver" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # KWin only loads effects built for its exact version: remind to rebuild.
  install -Dm644 sirkel-rebuild.hook "$pkgdir/usr/share/libalpm/hooks/sirkel-rebuild.hook"
}
