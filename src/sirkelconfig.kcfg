<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kcfg SYSTEM "http://www.kde.org/standards/kcfg/1.0/kcfg.dtd">
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kwinrc"/>
  <group name="Effect-sirkel">
    <!-- Pointer displacement (px) from the hyperkey-press position required
         before a horizontal direction (left/right) is armed. -->
    <entry name="HorizontalDeadzone" type="Int">
      <default>48</default>
    </entry>
    <!-- Pointer displacement (px) required before a vertical direction
         (top/bottom, or tipping a horizontal pick into a corner) is armed. -->
    <entry name="VerticalDeadzone" type="Int">
      <default>48</default>
    </entry>
    <!-- Gap (px) left on the left/right edges of a snapped window. -->
    <entry name="PaddingHorizontal" type="Int">
      <default>0</default>
    </entry>
    <!-- Gap (px) left on the top/bottom edges of a snapped window. -->
    <entry name="PaddingVertical" type="Int">
      <default>0</default>
    </entry>
    <!-- Diameter (px) of the center direction indicator. -->
    <entry name="IndicatorSize" type="Int">
      <default>120</default>
    </entry>
    <!-- Corner radius (px) of the small center direction indicator ring.
         0 = square frame, half of IndicatorSize = full circle. -->
    <entry name="IndicatorCornerRadius" type="Int">
      <default>60</default>
    </entry>
    <!-- Ring thickness (px) of the center direction indicator. -->
    <entry name="IndicatorRingWidth" type="Int">
      <default>24</default>
    </entry>
    <!-- Length (px) of the sliding pointer/marker along the indicator
         ring's own curve. Its thickness always matches IndicatorRingWidth
         (the pointer fills the ring it rides on, not an independent size). -->
    <entry name="IndicatorPointerLength" type="Int">
      <default>36</default>
    </entry>
    <!-- Whether the center indicator shows the direction name as text. -->
    <entry name="ShowIndicatorText" type="Bool">
      <default>false</default>
    </entry>
    <!-- Opacity (%) of the indicator's static base ring only - the
         pointer/marker and the text label always stay at full strength
         regardless of this setting. 100 = fully opaque. Renamed from
         IndicatorOpacity: "opacity"/"transparency" alone read as applying
         to the whole indicator, and as the inverse of what the number
         actually meant (higher = more opaque, not more transparent) -
         "ring fill opacity" matches OutlineFillOpacity's own naming and is
         unambiguous about both the direction and the scope. -->
    <entry name="IndicatorRingFillOpacity" type="Int">
      <default>100</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <!-- Border thickness (px) of the target-outline preview. 0 hides the
         border entirely, leaving just the fill (and Blur/Gradient fill, if
         those are on) to mark the target. -->
    <entry name="OutlineBorderWidth" type="Int">
      <default>2</default>
      <min>0</min>
    </entry>
    <!-- Corner radius (px) of the target-outline preview. -->
    <entry name="OutlineCornerRadius" type="Int">
      <default>4</default>
    </entry>
    <!-- Opacity (0-100) of a translucent fill inside the target-outline
         preview, in addition to its border. 0 = no fill (unchanged look). -->
    <entry name="OutlineFillOpacity" type="Int">
      <default>20</default>
    </entry>
    <!-- Whether the desktop behind the fill is blurred (via KWin's own
         Blur effect, KWindowEffects::enableBlurBehind() — a no-op if the
         user doesn't have Blur enabled in Desktop Effects). There's no
         separate "how much" setting: the blur radius itself is a single
         compositor-wide value KWin doesn't expose per-window at all, so
         OutlineFillOpacity above is what actually controls how much of it
         shows through versus the flat fill color once this is on. -->
    <entry name="OutlineBlur" type="Bool">
      <default>false</default>
    </entry>
    <!-- How long (ms) the target-outline preview takes to glide/resize
         between directions. 0 = instant (snaps straight to the new
         position/size, the original behavior). -->
    <entry name="OutlineAnimationDuration" type="Int">
      <default>75</default>
    </entry>
    <!-- Manually-picked color for the target-outline preview (and, when
         LinkIndicatorColors is true, the indicator's pointer and ring
         too), used when OutlineColorSource is "manual". Alpha channel is respected
         (KConfig's Color type round-trips it natively). This static
         default is effectively never seen in practice: OutlineColorSource
         defaults to "theme", which resolves to the live Plasma accent
         color instead — see resolveColor() in sirkeleffect.cpp /
         sirkelconfigmodule.cpp. Picking any color via the KCM (a swatch or
         the custom picker) sets OutlineColorSource to "manual" and stores
         the picked value here. -->
    <entry name="OutlineColor" type="Color">
      <default>61,174,233</default>
    </entry>
    <!-- Which key scheme selects a cardinal direction while armed. -->
    <entry name="KeybindScheme" type="String">
      <default>arrows</default>
    </entry>
    <!-- Whether the center direction indicator is shown at all. -->
    <entry name="ShowIndicator" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the target-outline preview is shown at all. -->
    <entry name="ShowOutline" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the center indicator tracks the live cursor position
         instead of staying fixed at the screen's center. -->
    <entry name="IndicatorFollowsMouse" type="Bool">
      <default>false</default>
    </entry>
    <!-- Manually-picked color for the indicator's pointer/marker, used when
         IndicatorPointerColorSource is "manual". Independent of
         OutlineColor and IndicatorRingColor unless LinkIndicatorColors is
         true. Renamed from IndicatorColor now that the ring has its own
         separate color (IndicatorRingColor below) - this one was always
         really the pointer's color, the ring never used it. -->
    <entry name="IndicatorPointerColor" type="Color">
      <default>61,174,233</default>
    </entry>
    <!-- Manually-picked color for the indicator's static base ring, used
         when IndicatorRingColorSource is "manual". Independent of
         OutlineColor and IndicatorPointerColor unless LinkIndicatorColors
         is true. Defaults to a solid, fully-opaque neutral gray matching
         the ring's original hardcoded look (which used to bake a fixed
         ~40% alpha directly into the color - now that's a separate,
         actually-controllable setting, IndicatorRingFillOpacity, this
         needs to default to fully opaque on its own so 100% fill opacity
         really does look solid). -->
    <entry name="IndicatorRingColor" type="Color">
      <default>46,52,64</default>
    </entry>
    <!-- Where the outline's color comes from: "manual" (OutlineColor, set
         via the KCM's picker), "theme" (the live Plasma accent color,
         re-resolved every time — see resolveColor() in sirkeleffect.cpp /
         sirkelconfigmodule.cpp), or "wallpaper" (WallpaperColorPath). -->
    <entry name="OutlineColorSource" type="String">
      <default>theme</default>
    </entry>
    <!-- Same as OutlineColorSource, for the indicator's pointer. Ignored
         when LinkIndicatorColors is true (the pointer just follows
         whatever the outline resolves to). -->
    <entry name="IndicatorPointerColorSource" type="String">
      <default>theme</default>
    </entry>
    <!-- Same as OutlineColorSource, for the indicator's ring. Ignored when
         LinkIndicatorColors is true. Defaults to "manual" (not "theme")
         so the ring keeps its own distinct neutral look out of the box,
         consistent with LinkIndicatorColors itself defaulting to false -
         see IndicatorRingColor's default for why. The KCM only offers
         "manual"/"theme" for this one (not "wallpaper") - the ring's whole
         point is to hold its own distinct identity, which a live-tracked
         wallpaper color works against; still a plain String here so
         nothing breaks if "wallpaper" ends up set some other way. -->
    <entry name="IndicatorRingColorSource" type="String">
      <default>manual</default>
    </entry>
    <!-- Whether the outline, the indicator's pointer, and the indicator's
         ring all use one shared color (true), or each has its own
         independent color/source (false). Defaults to false: with three
         distinct colors now in play, independent-by-default avoids
         silently overwriting the ring's own default look the first time
         someone touches any of these three. -->
    <entry name="LinkIndicatorColors" type="Bool">
      <default>false</default>
    </entry>
    <!-- Where to read a wallpaper-derived color from, when a color's source
         is "wallpaper". Empty (the default) means: use pywal's own default
         output, ~/.cache/wal/colors.json (colors.color1), no setup needed
         beyond having pywal installed and having run it at least once. A
         non-empty path is instead read as a single plain hex color
         (#RRGGBB or #RRGGBBAA) — the generic mechanism that also covers
         matugen (point one of its templates at this file) or anything
         else that can write out a plain hex color. -->
    <entry name="WallpaperColorPath" type="String">
      <default></default>
    </entry>
    <!-- Whether the directional snap/preview happens on the screen the
         cursor is on when the hyperkey is pressed, instead of always the
         active window's current screen. Snapshotted once at arm() time,
         not tracked live if the cursor crosses monitors mid-drag. -->
    <entry name="SnapToCursorScreen" type="Bool">
      <default>false</default>
    </entry>
    <!-- How a hyperkey press turns into an armed session: "instant" (arms
         immediately, the original behavior) or "delay" (must be held for
         TriggerDelay ms before it arms — releasing sooner cancels with no
         effect). A third mode, "doubleclick", existed briefly but was cut:
         it was the most complex trigger path (its own pending-gesture
         state machine) for what turned out to be the least-used of the
         three, and the one mode that had ever had a real confirmed bug. -->
    <entry name="TriggerMode" type="String">
      <default>instant</default>
    </entry>
    <!-- How long (ms) the hyperkey must be held before arming, when
         TriggerMode is "delay". Ignored for other modes. -->
    <entry name="TriggerDelay" type="Int">
      <default>300</default>
    </entry>
    <!-- While a direction is picked and the preview is showing, mouse-wheel
         scrolling resizes the target before release. Edge directions
         (Left/Right/Top/Bottom) resize only the one dimension that edge
         already controls (width for left/right, height for top/bottom) -
         the other stays full, exactly like today's half-snap. The four
         corners resize width only the same way (height stays at the
         quarter's usual half). Maximize also scales width only, shrinking
         in from both sides, centered horizontally - height stays full.
         Never persists between interactions - a fresh direction pick
         always starts back at the normal size. -->
    <entry name="ScrollResizeEnabled" type="Bool">
      <default>false</default>
    </entry>
    <!-- Appearance toggles - small motion/visual touches. Entrance,
         direction-intensity brightening, and the Maximize breathing pulse
         used to be separately switchable too; cut as settings (not as
         behavior - all three still happen) once it became clear nobody
         would plausibly want them off independently of everything else.
         Shared between Outline and Indicator (both read the same one): -->
    <!-- How the glide/grow animation (OutlineAnimationDuration) and the
         indicator pointer's slide ease into position: "linear" (constant
         speed, no easing at all), "smooth" (a plain ease-out,
         Easing.OutCubic), or "overshoot" (eases out past the target then
         settles back, Easing.OutBack - a touch of "bounce" instead of just
         arriving). Renamed/expanded from OvershootEasing (a plain bool) to
         make room for more curves later without another rename. -->
    <entry name="Easing" type="String">
      <default>overshoot</default>
    </entry>
    <!-- A brief brightness/scale pulse on the outline's fill right as the
         window actually snaps on release - separate from, and in addition
         to, the glide animation that gets it there. -->
    <entry name="OutlineConfirmFlash" type="Bool">
      <default>true</default>
    </entry>
    <!-- A subtle gradient (brighter top, dimmer bottom, same hue) instead
         of a flat translucent fill. Purely a paint change, no extra
         rendering cost - off by default as a style choice, not a
         performance one. -->
    <entry name="OutlineGradientFill" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
