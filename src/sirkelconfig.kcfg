<!DOCTYPE kcfg SYSTEM "http://www.kde.org/standards/kcfg/1.0/kcfg.dtd">
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name="kwinrc"/>
  <group name="Effect-sirkel">
    <!-- Box picking: how far (px) the pointer must move from the center
         on an axis before that axis counts (left/right, top/bottom; both
         for a corner). At least 1: at 0 every movement would count on both
         axes and pick a corner. Replaced HorizontalDeadzone and
         VerticalDeadzone. -->
    <entry name="Deadzone" type="Int">
      <default>48</default>
      <min>1</min>
    </entry>
    <!-- Gap (px) left on the left/right edges of a snapped window. -->
    <entry name="PaddingHorizontal" type="Int">
      <default>0</default>
    </entry>
    <!-- Gap (px) left on the top/bottom edges of a snapped window. -->
    <entry name="PaddingVertical" type="Int">
      <default>0</default>
    </entry>
    <!-- Diameter (px) of the center direction indicator. -->
    <entry name="IndicatorSize" type="Int">
      <default>120</default>
    </entry>
    <!-- Corner radius (px) of the small center direction indicator ring.
         0 = square frame, half of IndicatorSize = full circle. -->
    <entry name="IndicatorCornerRadius" type="Int">
      <default>60</default>
    </entry>
    <!-- Ring thickness (px) of the center direction indicator. Drawn at
         most half the indicator's size. -->
    <entry name="IndicatorRingWidth" type="Int">
      <default>24</default>
    </entry>
    <!-- Opacity (%) of the indicator's base ring only. The pointer always
         stays at full strength. 100 = fully opaque. -->
    <entry name="IndicatorRingFillOpacity" type="Int">
      <default>100</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <!-- Border thickness (px) of the target-outline preview. 0 hides the
         border entirely, leaving just the fill (and Blur/Gradient fill, if
         those are on) to mark the target. -->
    <entry name="OutlineBorderWidth" type="Int">
      <default>2</default>
      <min>0</min>
    </entry>
    <!-- Corner radius (px) of the target-outline preview. -->
    <entry name="OutlineCornerRadius" type="Int">
      <default>4</default>
    </entry>
    <!-- Opacity (0-100) of a translucent fill inside the target-outline
         preview, in addition to its border. 0 = no fill (unchanged look). -->
    <entry name="OutlineFillOpacity" type="Int">
      <default>20</default>
    </entry>
    <!-- Whether the desktop behind the fill is blurred (via KWin's own
         Blur effect, KWindowEffects::enableBlurBehind() — a no-op if the
         user doesn't have Blur enabled in Desktop Effects). There's no
         separate "how much" setting: the blur radius itself is a single
         compositor-wide value KWin doesn't expose per-window at all, so
         OutlineFillOpacity above is what actually controls how much of it
         shows through versus the flat fill color once this is on. -->
    <entry name="OutlineBlur" type="Bool">
      <default>false</default>
    </entry>
    <!-- How long (ms) the outline preview takes to glide between picks.
         Every other animation (pointer slide, entrance, exit) scales
         with it, and with KWin's global animation speed.
         0 = everything instant. -->
    <entry name="OutlineAnimationDuration" type="Int">
      <default>75</default>
    </entry>
    <!-- Color for the outline preview when OutlineColorSource is
         "manual". Alpha is respected. Picking a color in the KCM sets the
         source to "manual". -->
    <entry name="OutlineColor" type="Color">
      <default>61,174,233</default>
    </entry>
    <!-- Which key scheme selects a cardinal direction while armed. -->
    <entry name="KeybindScheme" type="String">
      <default>arrows</default>
    </entry>
    <!-- Whether the center direction indicator is shown at all. -->
    <entry name="ShowIndicator" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the target-outline preview is shown at all. -->
    <entry name="ShowOutline" type="Bool">
      <default>true</default>
    </entry>
    <!-- Whether the center indicator tracks the live cursor position
         instead of staying fixed at the screen's center. -->
    <entry name="IndicatorFollowsMouse" type="Bool">
      <default>false</default>
    </entry>
    <!-- Color for the indicator's pointer when IndicatorPointerColorSource
         is "manual". -->
    <entry name="IndicatorPointerColor" type="Color">
      <default>61,174,233</default>
    </entry>
    <!-- Color for the indicator's base ring when IndicatorRingColorSource
         is "manual". Fully opaque; IndicatorRingFillOpacity sets
         transparency. -->
    <entry name="IndicatorRingColor" type="Color">
      <default>46,52,64</default>
    </entry>
    <!-- Where the outline's color comes from: "manual" (OutlineColor) or
         "theme" (the live Plasma accent). Resolved fresh every session, see
         colorresolver.cpp. -->
    <entry name="OutlineColorSource" type="String">
      <default>theme</default>
    </entry>
    <!-- Same as OutlineColorSource, for the indicator's pointer. -->
    <entry name="IndicatorPointerColorSource" type="String">
      <default>theme</default>
    </entry>
    <!-- Same as OutlineColorSource, for the indicator's ring, except that
         "theme" gives a dark, muted version of the accent, so the pointer
         stands out against it. -->
    <entry name="IndicatorRingColorSource" type="String">
      <default>theme</default>
    </entry>
    <!-- Whether the directional snap/preview happens on the screen the
         cursor is on when the hyperkey is pressed, instead of always the
         active window's current screen. Snapshotted once at arm() time,
         not tracked live if the cursor crosses monitors mid-drag. -->
    <entry name="SnapToCursorScreen" type="Bool">
      <default>false</default>
    </entry>
    <!-- Seconds without any input after which a session cancels itself
         (nothing moves). Insurance against a missed hyperkey release.
         0 = never. On by default (10 s), so a missed release can't keep
         the keyboard grabbed. -->
    <entry name="SessionTimeout" type="Int">
      <default>10</default>
      <min>0</min>
    </entry>
    <!-- While a direction is picked and the preview is showing, mouse-wheel
         scrolling resizes the target before release. Edge directions
         (Left/Right/Top/Bottom) resize only the one dimension that edge
         already controls (width for left/right, height for top/bottom) -
         the other stays full, exactly like today's half-snap. The four
         corners resize width only the same way (height stays at the
         quarter's usual half). Maximize also scales width only, shrinking
         in from both sides, centered horizontally - height stays full.
         Never persists between interactions - a fresh direction pick
         always starts back at the normal size. -->
    <entry name="ScrollResizeEnabled" type="Bool">
      <default>false</default>
    </entry>
    <!-- Easing for the outline glide and the indicator pointer slide:
         "fluid" (strong ease-out with no overshoot, Loop's curves - the
         default), "linear", "smooth" (plain ease out) or "overshoot"
         (eases past the target and settles back). -->
    <entry name="Easing" type="String">
      <default>fluid</default>
    </entry>
    <!-- Applications Sirkel ignores entirely. Each entry is matched
         case-insensitively against the window's desktop file name and its
         window class (resource name/class), e.g. "steam" or
         "org.kde.konsole". -->
    <entry name="ExcludedApps" type="StringList">
      <default></default>
    </entry>
    <!-- How the mouse picks a direction: "box" (Deadzone checked per
         axis; corners need both) or "angle"
         (CenterRadius around the center, then eight 45 degree slices with
         slightly wider edge slices). -->
    <entry name="PickingMode" type="String">
      <default>box</default>
    </entry>
    <!-- Radius (px) of the center (Maximize) zone in "angle" picking mode. -->
    <entry name="CenterRadius" type="Int">
      <default>40</default>
      <min>5</min>
    </entry>
    <!-- Act on the window under the cursor when the hyperkey is pressed,
         instead of the active window. Falls back to the active window when
         the cursor isn't over a regular window. -->
    <entry name="TargetWindowUnderCursor" type="Bool">
      <default>false</default>
    </entry>
  </group>
</kcfg>
