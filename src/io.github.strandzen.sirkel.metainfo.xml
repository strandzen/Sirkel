<component type="desktop-application">
  <id>io.github.strandzen.sirkel</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Sirkel</name>
  <summary>Loop-style window snapping for KDE Plasma</summary>
  <description>
    <p>
      Hold a key combination or Caps Lock, move the mouse toward where you want the window, and let go.
      Sirkel snaps it to that half or quarter of the screen, or fills the screen.
      A small ring follows your direction and an outline shows where the window will end up.
    </p>
    <p>
      Sirkel is a KWin effect for Plasma on Wayland, inspired by Loop on macOS.
      KWin only loads effects built for its exact version, so Sirkel has to be rebuilt after every Plasma update.
    </p>
  </description>
  <launchable type="desktop-id">io.github.strandzen.sirkel.settings.desktop</launchable>
