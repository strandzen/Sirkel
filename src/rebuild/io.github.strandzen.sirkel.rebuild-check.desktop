# At login: a notification when KWin was updated and Sirkel needs a rebuild.
# Can be turned off in System Settings -> Autostart.
[Desktop Entry]
Type=Application
Name=Sirkel rebuild check
Comment=Tells you when Sirkel needs a rebuild after a KWin update
Exec=sirkel-rebuild --check
Icon=io.github.strandzen.sirkel
NoDisplay=true
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
