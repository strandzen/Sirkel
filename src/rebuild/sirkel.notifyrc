[Global]
IconName=io.github.strandzen.sirkel
Name=Sirkel
Comment=Sirkel window tiling

[Event/rebuildNeeded]
Name=Rebuild needed
Comment=Sirkel needs a rebuild after a KWin update
Action=Popup

[Event/rebuildProblem]
Name=Rebuild problem
Comment=A rebuild of Sirkel couldn't be started
Action=Popup
